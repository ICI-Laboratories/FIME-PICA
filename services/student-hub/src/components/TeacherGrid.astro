---
interface Teacher {
  slug: string;
  fullName: string;
  photoUrl?: string;
  title: string;
  department: string;
  quote: string;
  delegation_id?: number;
  faculty_id?: number;
  career_ids?: number[];
}

interface Props {
  profesores: Teacher[];
}

const { profesores = [] } = Astro.props;

function cleanName(name: string) {
  return name.replace(/^(dr\.|dra\.|mtro\.|mtra\.|lic\.|ing\.|arq\.)\s*/i, '');
}
---

<div class="teachers-grid">
  {profesores.map((prof) => {
    const cleanFullName = cleanName(prof.fullName);
    return (
      <div
        class="teacher-card"
        data-delegation={prof.delegation_id}
        data-faculty={prof.faculty_id || ''}
        data-careers={JSON.stringify(prof.career_ids || [])}
        style="
          background-color: var(--color-ground);
          border: 1px solid var(--color-border);
          border-left: 3px solid var(--color-primary);
          border-radius: 2px;
          padding: 20px;
          display: flex;
          flex-direction: row;
          gap: 16px;
          transition: border-color 150ms;
        "
        onmouseover="this.style.borderColor='var(--color-secondary)'; this.style.borderLeftColor='var(--color-secondary)';"
        onmouseout="this.style.borderColor='var(--color-border)'; this.style.borderLeftColor='var(--color-primary)';"
      >
        <!-- Avatar -->
        <div style="flex-shrink: 0;">
          <div style="
            width: 72px;
            height: 72px;
            background-color: var(--color-bg-piedra, #f1f5f9);
            border: 1px solid var(--color-border, #cbd5e1);
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
          ">
            {prof.photoUrl ? (
              <img
                src={prof.photoUrl}
                alt={`Fotografía de ${prof.fullName}`}
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover;"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div style={`width: 100%; height: 100%; display: ${prof.photoUrl ? 'none' : 'flex'}; align-items: center; justify-content: center; background-color: #e2e8f0; color: #006633; font-weight: 800; font-size: 1.25rem; font-family: monospace; text-transform: uppercase;`}>
              {cleanFullName.split(/\s+/).filter(Boolean).map(n => n[0]).slice(0, 2).join('')}
            </div>
          </div>
        </div>

        <!-- Información -->
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
          <div>
            <h2 style="
              font-size: 1.25rem;
              font-weight: 800;
              color: var(--color-text-primary);
              line-height: 1.1;
              margin-bottom: 6px;
            ">
              <a
                href={`/profesores/${prof.slug}`}
                style="color: inherit; text-decoration: none; transition: color 150ms;"
                onmouseover="this.style.color='var(--color-primary)';"
                onmouseout="this.style.color='var(--color-text-primary)';"
              >{cleanFullName}</a>
            </h2>
            <p style="
              font-size: 0.75rem;
              color: var(--color-text-secondary);
              line-height: 1.3;
              overflow: hidden;
              white-space: nowrap;
              text-overflow: ellipsis;
            ">{prof.department}</p>
            {prof.quote && (
              <p style="
                font-size: 0.75rem;
                font-style: italic;
                color: var(--color-ink-3);
                border-left: 2px solid var(--color-border);
                padding-left: 10px;
                margin-top: 8px;
                line-height: 1.4;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
              ">"{prof.quote}"</p>
            )}
          </div>
          <div>
            <a
              href={`/profesores/${prof.slug}`}
              style="
                font-family: var(--font-mono);
                font-size: 0.5625rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--color-secondary);
                text-decoration: none;
              "
              onmouseover="this.style.textDecoration='underline';"
              onmouseout="this.style.textDecoration='none';"
            >Ver perfil completo &rarr;</a>
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  .teachers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .teachers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
