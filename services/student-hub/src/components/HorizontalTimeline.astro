---
interface DegreeRaw {
  degree: string;
  institution: string;
  year: number;
}

interface Props {
  academicFormation: {
    doctorados?: DegreeRaw[];
    maestrias?: DegreeRaw[];
    licenciatura?: DegreeRaw;
  };
}

const { academicFormation } = Astro.props;

interface TimelineNode {
  label: string;      // Ej: "Dr." o "Mtro."
  degreeShort: string; // Ej: "Tec. Educativa"
  degreeFull: string;
  institution: string;
  year: number;
}

const nodes: TimelineNode[] = [];

// Procesar Licenciatura
if (academicFormation && academicFormation.licenciatura) {
  const lic = academicFormation.licenciatura;
  let short = lic.degree || '';
  if (short.toLowerCase().startsWith('ingeniería en ')) {
    short = short.substring(14);
  } else if (short.toLowerCase().startsWith('licenciatura en ')) {
    short = short.substring(16);
  }
  if (short.length > 22) short = short.slice(0, 20) + '...';

  nodes.push({
    label: 'Lic.',
    degreeShort: short,
    degreeFull: lic.degree || '',
    institution: lic.institution || '',
    year: lic.year || 0
  });
}

// Procesar Maestrias
if (academicFormation && academicFormation.maestrias && Array.isArray(academicFormation.maestrias)) {
  academicFormation.maestrias.forEach(mae => {
    if (!mae) return;
    let short = mae.degree || '';
    if (short.toLowerCase().startsWith('maestría en ')) {
      short = short.substring(12);
    }
    if (short.length > 22) short = short.slice(0, 20) + '...';

    nodes.push({
      label: 'Mtro.',
      degreeShort: short,
      degreeFull: mae.degree || '',
      institution: mae.institution || '',
      year: mae.year || 0
    });
  });
}

// Procesar Doctorados
if (academicFormation && academicFormation.doctorados && Array.isArray(academicFormation.doctorados)) {
  academicFormation.doctorados.forEach(doc => {
    if (!doc) return;
    let short = doc.degree || '';
    if (short.toLowerCase().startsWith('doctorado en ')) {
      short = short.substring(13);
    } else if (short.toLowerCase().startsWith('doctor en ')) {
      short = short.substring(10);
    } else if (short.toLowerCase().startsWith('doctora en ')) {
      short = short.substring(11);
    }
    if (short.length > 22) short = short.slice(0, 20) + '...';

    nodes.push({
      label: 'Dr.',
      degreeShort: short,
      degreeFull: doc.degree || '',
      institution: doc.institution || '',
      year: doc.year || 0
    });
  });
}

// Ordenar cronológicamente (más antiguo a más reciente)
nodes.sort((a, b) => a.year - b.year);
---

<div class="py-4">
  <span class="overline overline--primary mb-6">Trayectoria de Formación</span>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative mt-4">
    {nodes.map((node) => (
      <div class="flex flex-col relative pl-6 border-l-2 border-primary md:border-l-0 md:pl-0 md:pt-6 md:border-t-2 md:border-rule-strong">
        <!-- Punto indicador sobre la línea de tiempo -->
        <div class="absolute left-[-6px] top-0 w-2.5 h-2.5 bg-primary md:left-0 md:top-[-6px]"></div>
        
        <span class="font-mono text-xs font-black text-primary block leading-none mb-1">
          {node.year}
        </span>
        <strong class="text-sm font-bold text-ink block leading-tight mb-1" title={node.degreeFull}>
          {node.label} en {node.degreeShort}
        </strong>
        <span class="text-xs text-ink-3 block leading-normal">
          {node.institution}
        </span>
      </div>
    ))}
  </div>
</div>
