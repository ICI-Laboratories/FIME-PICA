    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 32px;
    align-items: end;
  }

  @media (min-width: 768px) {
    .page-header {
      grid-template-columns: 2fr 1fr;
      gap: 48px;
    }
  }

  .page-title {
    font-size: 2.5rem;       /* 40px — presencia editorial */
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title { font-size: 3rem; }    /* 48px en desktop */
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
