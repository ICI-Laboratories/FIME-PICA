---
import InstitutionalLayout from "../layouts/InstitutionalLayout.astro";
import { fetchFromService } from "../lib/api-client.js";

const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

let schedules = [];
try {
  schedules = await fetchFromService('academic', '/schedules');
} catch (e) {
  console.error("Error al cargar horarios para el mapa:", e);
}

const schedulesJson = JSON.stringify(schedules);
---

<InstitutionalLayout title="Mapa de Instalaciones" fromLanding={Astro.url.searchParams.get("from") === "landing"}>

  <!-- ==========================================
       1. ENCABEZADO ASIMÉTRICO (Diseño Suizo)
       ========================================== -->
  <div class="page-header">
    <div class="page-header__content">
      <span class="overline overline--primary">Instalaciones Físicas</span>
      <h1 class="page-title">Mapa del Campus</h1>
      <p class="page-subtitle">
        Navegación espacial de aulas y laboratorios universitarios.
      </p>
    </div>
  </div>

  <hr class="rule rule--thick" style="margin-bottom: 48px;" />

  <!-- ==========================================
       2. CONTENEDOR PRINCIPAL: MAPA + PANEL
       ========================================== -->
  <div class="map-layout">
    
    <!-- COLUMNA 1: El Mapa Interactivo (Leaflet) -->
    <div class="map-container-wrapper">
      <div class="search-box-container" style="margin-bottom: 16px; position: relative;">
        <label for="map-search-input" class="overline" style="margin-bottom: 6px;">Buscar espacio o aula</label>
        <div style="display: flex; gap: 8px;">
          <input 
            type="search" 
            id="map-search-input" 
            class="input" 
            placeholder="Ej. Telemática, Aula 1..." 
            style="flex: 1;"
          />
          <button id="btn-clear-search" class="btn btn--ghost" style="height: 44px; display: none;">Limpiar</button>
        </div>
        <div id="search-suggestions" class="search-suggestions" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--color-surface); border: 1px solid var(--color-rule-strong); z-index: 100; max-height: 200px; overflow-y: auto;"></div>
      </div>
      <div id="map" class="interactive-map"></div>
      <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 12px; text-align: right;">
        * Cartografía base monocromática. Haz clic en los polígonos resaltados. Los mapas geográficos requieren conexión a la red.
      </p>
    </div>

    <!-- COLUMNA 2: Panel de Información Dinámica -->
    <div class="info-panel-wrapper">
      <div class="info-panel" id="space-details-panel">
        <span class="overline" style="margin-bottom: 16px; display: block;">Detalle de Espacio</span>
        
        <!-- Estado Inicial (Vacío) -->
        <div id="panel-empty-state" class="empty-state">
          Selecciona un espacio en el mapa interactivo para consultar su programación y características.
        </div>

        <!-- Estado Activo -->
        <div id="panel-content-state" style="display: none;">
          <div>
            <span id="panel-space-type" class="tag" style="margin-bottom: 8px;">Tipo</span>
            <h2 id="panel-space-name" style="font-size: 2rem; font-weight: 800; color: var(--color-ink); line-height: 1.1; letter-spacing: -0.03em;">
              Nombre Espacio
            </h2>
          </div>
          
          <hr class="rule" style="margin: 24px 0;" />

          <!-- Vista de Aulas Internas para Estudiantes -->
          <div id="panel-rooms-read-only" style="margin-bottom: 24px; display: none;">
            <span class="overline" style="margin-bottom: 10px; display: block; color: var(--color-ink-2);">Aulas y Laboratorios</span>
            <div id="panel-rooms-read-only-list" style="display: flex; flex-wrap: wrap; gap: 6px;">
              <!-- Se insertan por JS -->
            </div>
            <hr class="rule" style="margin: 24px 0 0 0;" />
          </div>

          <div>
            <span class="overline" style="margin-bottom: 12px; display: block; color: var(--color-primary);">Clases Programadas</span>
            <div id="panel-classes-list" style="display: flex; flex-direction: column; gap: 16px;">
              <!-- Se insertan por JS -->
            </div>
          </div>

          <div id="panel-editor-helper" style="display: none; margin-top: 24px; padding: 16px; background: var(--color-muted); border: 1px solid var(--color-rule-strong); font-size: 0.8125rem; font-family: var(--font-sans);">
            <strong style="color: var(--color-ink); display: block; margin-bottom: 12px; font-size: 0.875rem; font-family: var(--font-mono);">[EDIT] Editor de Edificio</strong>
            
            <div style="margin-bottom: 16px;">
              <label for="panel-space-name-input" class="overline" style="display: block; margin-bottom: 4px;">Nombre del Edificio</label>
              <input type="text" id="panel-space-name-input" class="input" style="width: 100%; box-sizing: border-box;" placeholder="Ej. Edificio B..." />
            </div>

            <!-- Listado de Aulas / Laboratorios -->
            <div style="margin-bottom: 16px;">
              <label class="overline" style="display: block; margin-bottom: 8px;">Aulas y Laboratorios Internos</label>
              <div id="panel-editor-rooms-list" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 12px;">
                <!-- Dinámicamente insertado por JS -->
              </div>
              <button type="button" id="btn-add-room-editor" class="btn btn--ghost" style="width: 100%; font-size: 0.75rem; padding: 8px; border: 1px dashed var(--color-rule-strong);">+ Agregar Aula/Lab</button>
            </div>

            <div style="margin-bottom: 16px;">
              <label class="overline" style="display: block; margin-bottom: 4px;">ID Único (GeoJSON)</label>
              <input type="text" id="panel-space-id-input" readonly style="width: 100%; font-family: var(--font-mono); font-size: 0.6875rem; padding: 6px; border: 1px solid var(--color-rule-strong); background: var(--color-surface); color: var(--color-ink); box-sizing: border-box;" onclick="this.select();" />
            </div>

            <button id="btn-save-space" class="btn btn--primary" style="width: 100%; padding: 10px;">Guardar en GeoJSON</button>
            <button id="btn-delete-space" class="btn btn--danger" style="width: 100%; padding: 10px; margin-top: 8px; background-color: #ff3b30; color: white; border: none; cursor: pointer; font-family: var(--font-sans); font-weight: 700; transition: all 120ms;">Borrar Edificio Completo</button>
            <div id="save-status-msg" style="display: none; font-size: 0.75rem; font-weight: 700; margin-top: 8px; text-align: center; text-transform: uppercase;"></div>          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Inyección de Datos -->
  <script is:inline define:vars={{ schedulesJson }}>
    window.__SCHEDULES__ = JSON.parse(schedulesJson);
  </script>

  <!-- ==========================================
       3. INTEGRACIÓN DE LEAFLET.JS (LOCAL BUNDLE)
       ========================================== -->
  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    (function initLeaflet() {
      // 1. Inicializar Mapa (Centrado aproximado en la UCOL Telemática)
      const map = L.map('map', {
        zoomControl: false // Lo reposicionaremos
      }).setView([19.2135, -103.804], 18);

      L.control.zoom({ position: 'bottomright' }).addTo(map);

      // 2. Capa Base Monocromática (CartoDB Positron) para adherirse al Swiss Design
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 20
      }).addTo(map);

      // Elementos del DOM para el panel
      const emptyState = document.getElementById("panel-empty-state");
      const contentState = document.getElementById("panel-content-state");
      const pName = document.getElementById("panel-space-name");
      const pType = document.getElementById("panel-space-type");
      const pClassesList = document.getElementById("panel-classes-list");
      const pSpaceIdInput = document.getElementById("panel-space-id-input");
      const pSpaceNameInput = document.getElementById("panel-space-name-input");
      const pRoomsListContainer = document.getElementById("panel-editor-rooms-list");
      const pRoomsReadOnly = document.getElementById("panel-rooms-read-only");
      const pRoomsReadOnlyList = document.getElementById("panel-rooms-read-only-list");
      const btnSaveSpace = document.getElementById("btn-save-space");
      const btnDeleteSpace = document.getElementById("btn-delete-space");
      const saveStatusMsg = document.getElementById("save-status-msg");

      const faculties = ["FIME", "FIC", "FCQ", "FAYD"];
      let clickedLayer = null;
      let localSpaces = [];

      // Renderizar listado de aulas internas en el editor
      function renderEditorRooms() {
        if (!pRoomsListContainer) return;
        pRoomsListContainer.innerHTML = "";
        
        if (localSpaces.length === 0) {
          pRoomsListContainer.innerHTML = '<span style="font-style: italic; color: var(--color-ink-3); font-size: 0.75rem; display: block; text-align: center; padding: 8px 0;">Sin aulas o laboratorios internos registrados</span>';
        }

        localSpaces.forEach((room, idx) => {
          const row = document.createElement("div");
          row.style.cssText = "display: flex; flex-direction: column; gap: 6px; padding: 10px; border: 1px solid var(--color-rule-strong); background: var(--color-surface); margin-bottom: 8px;";
          
          const facultyIdx = faculties.indexOf(room.faculty);
          const currentFacultyVal = facultyIdx >= 0 ? facultyIdx : 0;
          
          row.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span class="overline" style="font-size: 0.6rem; color: var(--color-ink-3);">Aula / Lab #${idx + 1}</span>
              <button type="button" class="btn-remove-room" data-idx="${idx}" style="background: none; border: none; color: #ff3b30; font-size: 0.65rem; cursor: pointer; text-transform: uppercase; font-family: var(--font-mono); font-weight: 700; padding: 2px 4px;">Eliminar</button>
            </div>
            <input type="text" class="room-name-input input" style="padding: 6px; font-size: 0.75rem; width: 100%; box-sizing: border-box;" value="${room.name || ''}" placeholder="Nombre del Aula / Laboratorio" />
            <div style="margin-top: 4px;">
              <label class="overline" style="font-size: 0.55rem; display: block; margin-bottom: 2px;">Facultad</label>
              <input type="range" class="room-faculty-slider" min="0" max="3" step="1" value="${currentFacultyVal}" style="width: 100%; cursor: pointer;" />
              <div style="display: flex; justify-content: space-between; font-size: 0.5rem; color: var(--color-ink-3); margin-top: 2px;">
                <span>FIME</span>
                <span>FIC</span>
                <span>FCQ</span>
                <span>FAYD</span>
              </div>
              <div class="room-faculty-display" style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-primary); margin-top: 4px; text-align: center; background: var(--color-muted); padding: 2px; border: 1px solid var(--color-rule-strong);">${room.faculty || 'FIME'}</div>
            </div>
          `;
          
          const slider = row.querySelector(".room-faculty-slider");
          const display = row.querySelector(".room-faculty-display");
          const nameInput = row.querySelector(".room-name-input");
          
          slider.addEventListener('input', () => {
            const fac = faculties[slider.value];
            display.textContent = fac;
            localSpaces[idx].faculty = fac;
          });
          
          nameInput.addEventListener('input', () => {
            localSpaces[idx].name = nameInput.value;
          });
          
          row.querySelector(".btn-remove-room").addEventListener('click', () => {
            localSpaces.splice(idx, 1);
            renderEditorRooms();
          });

          pRoomsListContainer.appendChild(row);
        });
      }

      // Botón agregar aula en el editor
      document.getElementById("btn-add-room-editor")?.addEventListener('click', () => {
        localSpaces.push({ name: "", faculty: "FIME" });
        renderEditorRooms();
      });

      // Guardar cambios a través de la API
      btnSaveSpace?.addEventListener('click', async () => {
        if (!clickedLayer) return;
        const id = pSpaceIdInput.value;
        const name = pSpaceNameInput.value.trim();

        if (saveStatusMsg) {
          saveStatusMsg.style.display = "block";
          saveStatusMsg.style.color = "var(--color-ink-2)";
          saveStatusMsg.textContent = "Guardando...";
        }

        try {
          const res = await fetch('/api/save-space', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, name, spaces: localSpaces })
          });

          if (res.ok) {
            if (saveStatusMsg) {
              saveStatusMsg.style.color = "var(--color-primary)";
              saveStatusMsg.textContent = "¡Guardado con éxito!";
            }

            // Actualizar propiedades locales en la capa de Leaflet
            clickedLayer.feature.properties.name = name;
            clickedLayer.feature.properties.spaces = JSON.parse(JSON.stringify(localSpaces));

            // Refrescar el estilo y el tooltip de la capa
            geojsonLayer.resetStyle(clickedLayer);
            clickedLayer.unbindTooltip();
            if (name) {
              clickedLayer.bindTooltip(name, {
                className: 'swiss-tooltip',
                direction: 'top'
              });
            }

            if (pName) pName.textContent = name || "Edificio sin nombre";

            setTimeout(() => {
              if (saveStatusMsg) saveStatusMsg.style.display = "none";
            }, 2500);
          } else {
            const err = await res.json();
            if (saveStatusMsg) {
              saveStatusMsg.style.color = "red";
              saveStatusMsg.textContent = "Error: " + err.error;
            }
          }
        } catch (e) {
          if (saveStatusMsg) {
            saveStatusMsg.style.color = "red";
            saveStatusMsg.textContent = "Error de conexión";
          }
        }
      });

      // Borrar edificio completo
      btnDeleteSpace?.addEventListener('click', async () => {
        if (!clickedLayer) return;
        const id = pSpaceIdInput.value;

        if (!confirm("¿Estás seguro de que deseas eliminar este edificio por completo del GeoJSON?")) {
          return;
        }

        if (saveStatusMsg) {
          saveStatusMsg.style.display = "block";
          saveStatusMsg.style.color = "var(--color-ink-2)";
          saveStatusMsg.textContent = "Eliminando...";
        }

        try {
          const res = await fetch('/api/delete-space', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          if (res.ok) {
            if (saveStatusMsg) {
              saveStatusMsg.style.color = "var(--color-primary)";
              saveStatusMsg.textContent = "¡Edificio eliminado con éxito!";
            }

            // Remover la capa del mapa
            if (geojsonLayer && clickedLayer) {
              geojsonLayer.removeLayer(clickedLayer);
            }

            clickedLayer = null;

            // Limpiar panel lateral
            setTimeout(() => {
              if (saveStatusMsg) saveStatusMsg.style.display = "none";
              if (emptyState) emptyState.style.display = "block";
              if (contentState) contentState.style.display = "none";
            }, 1500);
          } else {
            const err = await res.json();
            if (saveStatusMsg) {
              saveStatusMsg.style.color = "red";
              saveStatusMsg.textContent = "Error: " + err.error;
            }
          }
        } catch (e) {
          if (saveStatusMsg) {
            saveStatusMsg.style.color = "red";
            saveStatusMsg.textContent = "Error de conexión";
          }
        }
      });

      function isRoomMatch(targetStr, spaceStr) {
        if (!targetStr || !spaceStr) return false;
        
        const clean = (str) => str.toString()
          .toLowerCase()
          .replace(/^(aula|laboratorio|taller|edificio)\s+/, '')
          .replace(/\(.*\)/, '')
          .replace(/[°ª]/g, '')
          .trim();

        const normTarget = clean(targetStr);
        const normSpace = clean(spaceStr);

        if (normTarget === normSpace) return true;

        if (normTarget.includes('/')) {
          const parts = normTarget.split('/').map(p => clean(p));
          if (parts.some(p => p === normSpace || (p.length >= 2 && normSpace.includes(p)))) return true;
        }
        if (normSpace.includes('/')) {
          const parts = normSpace.split('/').map(p => clean(p));
          if (parts.some(p => p === normTarget || (p.length >= 2 && normTarget.includes(p)))) return true;
        }

        if (normTarget.length >= 2 && normSpace.includes(normTarget)) return true;
        if (normSpace.length >= 2 && normTarget.includes(normSpace)) return true;

        return false;
      }

      // Función para renderizar detalles del panel lateral
      function displaySpaceDetails(feature) {
        if (emptyState) emptyState.style.display = "none";
        if (contentState) contentState.style.display = "block";

        const props = feature.properties || {};
        const spaceId = props.id || feature.id || "N/A";
        const spaceName = props.name || "Edificio sin nombre";
        
        localSpaces = props.spaces ? JSON.parse(JSON.stringify(props.spaces)) : [];
        
        if (pName) pName.textContent = spaceName;
        if (pSpaceIdInput) pSpaceIdInput.value = spaceId;
        if (pSpaceNameInput) pSpaceNameInput.value = props.name || "";
        
        renderEditorRooms();

        // Renderizar vista de solo lectura de aulas internas
        if (pRoomsReadOnly && pRoomsReadOnlyList) {
          pRoomsReadOnlyList.innerHTML = "";
          if (localSpaces.length > 0) {
            localSpaces.forEach(room => {
              const tag = document.createElement("span");
              tag.style.cssText = `
                display: inline-block;
                padding: 4px 8px;
                font-size: 0.75rem;
                font-family: var(--font-sans);
                font-weight: 700;
                border-radius: 4px;
                border: 1px solid ${getFacultyColor(room.faculty)};
                background: ${getFacultyColor(room.faculty)}15;
                color: ${getFacultyColor(room.faculty)};
              `;
              tag.textContent = `${room.name} (${room.faculty})`;
              pRoomsReadOnlyList.appendChild(tag);
            });
            pRoomsReadOnly.style.display = "block";
          } else {
            pRoomsReadOnly.style.display = "none";
          }
        }

        if (pType) {
          const typeStr = props.amenity || props.building || 'general';
          pType.textContent = typeStr.charAt(0).toUpperCase() + typeStr.slice(1);
          pType.className = 'tag tag--primary';
        }

        // Buscar clases programadas para cualquiera de los sub-espacios de este edificio
        if (pClassesList) {
          pClassesList.innerHTML = "";
          
          const classes = window.__SCHEDULES__.filter(s => {
            if (!s.classroom_name) return false;
            if (isRoomMatch(s.classroom_name, spaceName)) return true;
            return localSpaces.some(r => r.name && isRoomMatch(s.classroom_name, r.name));
          });

          if (classes && classes.length > 0) {
            classes.forEach(c => {
              const row = document.createElement("div");
              row.style.cssText = "padding-bottom: 12px; border-bottom: 1px solid var(--color-rule);";
              row.innerHTML = 
                '<strong style="display: block; font-size: 1rem; color: var(--color-ink); margin-bottom: 4px;">' + c.subject_name + '</strong>' +
                '<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8125rem; color: var(--color-ink-2);">' +
                '<span>Grupo: <strong style="color: var(--color-ink);">' + (c.group_name || c.class_group_name || "") + '</strong></span>' +
                '<span style="font-family: var(--font-mono);">' + c.day_of_week + ' ' + c.start_time.substring(0,5) + '-' + c.end_time.substring(0,5) + '</span>' +
                '</div>' +
                '<span style="display: block; font-size: 0.75rem; color: var(--color-ink-3); margin-top: 4px;">Espacio: <strong>' + (c.classroom_name || "N/A") + '</strong> | Docente: ' + (c.professor_name || "Sin asignar") + '</span>';
              pClassesList.appendChild(row);
            });
          } else {
            pClassesList.innerHTML = 
              '<p style="font-size: 0.875rem; color: var(--color-ink-3); font-style: italic;">No hay clases programadas académicamente en este momento.</p>';
          }
        }
      }

      // Colores de Facultades para el Swiss Map
      function getFacultyColor(faculty) {
        switch (faculty) {
          case 'FIME': return '#4caf50'; // Verde
          case 'FIC': return '#2196f3';  // Azul
          case 'FCQ': return '#ff9800';  // Naranja
          case 'FAYD': return '#e91e63'; // Rosa/Magente
          default: return 'var(--color-ink)'; // Gris oscuro
        }
      }

      // Estilo de los Polígonos GeoJSON (pintado por la facultad de la primera aula registrada)
      function baseStyle(feature) {
        const props = feature.properties || {};
        const spaces = props.spaces || [];
        const faculty = spaces.length > 0 ? spaces[0].faculty : props.faculty;
        const color = getFacultyColor(faculty);
        return {
          color: "var(--color-ink)",
          weight: 1,
          fillColor: color,
          fillOpacity: faculty ? 0.35 : 0.05
        };
      }

      let geojsonLayer;

      // 4. Cargar GeoJSON
      fetch('/campus.geojson')
        .then(res => res.json())
        .then(data => {
          geojsonLayer = L.geoJSON(data, {
            style: baseStyle,
            onEachFeature: (feature, layer) => {
              // Tooltip básico al hover
              if (feature.properties && feature.properties.name) {
                layer.bindTooltip(feature.properties.name, {
                  className: 'swiss-tooltip',
                  direction: 'top'
                });
              }

              // Eventos de interacción
              layer.on({
                mouseover: (e) => {
                  const l = e.target;
                  l.setStyle({
                    color: "var(--color-primary)",
                    weight: 2,
                    fillOpacity: 0.5
                  });
                  if (!L.Browser.ie && !L.Browser.opera && !L.Browser.edge) {
                    l.bringToFront();
                  }
                },
                mouseout: (e) => {
                  geojsonLayer.resetStyle(e.target);
                },
                click: (e) => {
                  clickedLayer = e.target;
                  map.fitBounds(e.target.getBounds(), { padding: [50, 50] });
                  displaySpaceDetails(feature);
                }
              });
            }
          }).addTo(map);

          // Ajustar mapa a los datos iniciales
          const bounds = geojsonLayer.getBounds();
          if (bounds.isValid()) {
            map.fitBounds(bounds);
            
            // Limitar el mapa estríctamente a esta zona (impedir drag fuera del campus)
            map.setMaxBounds(bounds.pad(0.05));
            // Prevenir zoom-out excesivo
            map.setMinZoom(map.getBoundsZoom(bounds));
          }

           // Checar URL Params para auto-selección e indicación de edición
           const urlParams = new URLSearchParams(window.location.search);
           const highlightName = urlParams.get('highlight');
           const isEditMode = urlParams.get('edit') === 'true';

           const editorHelper = document.getElementById("panel-editor-helper");
           if (editorHelper && isEditMode) {
             editorHelper.style.display = "block";
           }
           
           if (highlightName) {
             let foundLayer = null;
             geojsonLayer.eachLayer(layer => {
               if (foundLayer) return;
               const props = layer.feature.properties || {};
               const bName = props.name || "";
               const spaces = props.spaces || [];
               
               if (isRoomMatch(highlightName, bName)) {
                 foundLayer = layer;
                 return;
               }
               if (spaces.some(sp => isRoomMatch(highlightName, sp.name))) {
                 foundLayer = layer;
                 return;
               }
             });

             if (foundLayer) {
               map.fitBounds(foundLayer.getBounds(), { maxZoom: 20, padding: [50, 50] });
               foundLayer.fire('click');
             }
           }

          // ── Search & Filter Logic ──
          const searchInput = document.getElementById("map-search-input");
          const clearBtn = document.getElementById("btn-clear-search");
          const suggestionsContainer = document.getElementById("search-suggestions");

          function performSearch(query) {
            if (!query) {
              suggestionsContainer.style.display = "none";
              clearBtn.style.display = "none";
              return;
            }
            
            clearBtn.style.display = "block";
            const normalizedQuery = query.toLowerCase().trim();
            const matches = [];

            geojsonLayer.eachLayer(layer => {
              const buildingName = layer.feature.properties?.name || "Edificio";
              const spaces = layer.feature.properties?.spaces || [];
              spaces.forEach(space => {
                if (space.name && space.name.toLowerCase().includes(normalizedQuery)) {
                  matches.push({ 
                    displayName: `${space.name} (${buildingName})`, 
                    searchName: space.name,
                    layer 
                  });
                }
              });
            });

            if (matches.length > 0) {
              suggestionsContainer.innerHTML = matches.map((m, idx) => 
                `<button class="suggestion-item" style="display: block; width: 100%; text-align: left; padding: 10px 16px; background: none; border: none; border-bottom: 1px solid var(--color-rule); cursor: pointer; font-size: 0.875rem; font-family: var(--font-sans); color: var(--color-ink);" data-idx="${idx}">${m.displayName}</button>`
              ).join('');
              suggestionsContainer.style.display = "block";

              // Add click listener to suggestions
              suggestionsContainer.querySelectorAll(".suggestion-item").forEach(item => {
                item.addEventListener("click", () => {
                  const idx = parseInt(item.getAttribute("data-idx"), 10);
                  const match = matches[idx];
                  if (match) {
                    map.fitBounds(match.layer.getBounds(), { padding: [50, 50] });
                    match.layer.fire("click");
                    searchInput.value = match.searchName;
                    suggestionsContainer.style.display = "none";
                  }
                });
              });
            } else {
              suggestionsContainer.innerHTML = `<div style="padding: 10px 16px; font-size: 0.875rem; color: var(--color-ink-3); font-style: italic;">No se encontraron espacios</div>`;
              suggestionsContainer.style.display = "block";
            }
          }

          searchInput?.addEventListener("input", (e) => {
            performSearch(e.target.value);
          });

          clearBtn?.addEventListener("click", () => {
            if (searchInput) searchInput.value = "";
            suggestionsContainer.style.display = "none";
            clearBtn.style.display = "none";
          });

          // Close suggestions when clicking outside
          document.addEventListener("click", (e) => {
            if (!suggestionsContainer.contains(e.target) && e.target !== searchInput) {
              suggestionsContainer.style.display = "none";
            }
          });
        })
        .catch(err => console.error("Error cargando GeoJSON:", err));
    })();
  </script>

</InstitutionalLayout>

