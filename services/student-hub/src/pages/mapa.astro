---
import InstitutionalLayout from "../layouts/InstitutionalLayout.astro";
import { fetchFromService } from "../lib/api-client.js";

let schedules = [];
try {
  schedules = await fetchFromService('academic', '/schedules');
} catch (e) {
  console.error("Error al cargar horarios para el mapa:", e);
}

const schedulesJson = JSON.stringify(schedules);
---

<InstitutionalLayout title="Mapa de Instalaciones" fromLanding={Astro.url.searchParams.get("from") === "landing"}>

  <!-- ==========================================
       1. ENCABEZADO ASIMÉTRICO (Diseño Suizo)
       ========================================== -->
  <div class="page-header">
    <div class="page-header__content">
      <span class="overline overline--primary">Instalaciones Físicas</span>
      <h1 class="page-title">Mapa del Campus</h1>
      <p class="page-subtitle">
        Encuentra edificios, aulas y laboratorios de FIME en el campus Coquimatlán.
      </p>
    </div>
  </div>

  <hr class="rule rule--thick" style="margin-bottom: 48px;" />

  <!-- ==========================================
       2. CONTENEDOR PRINCIPAL: MAPA + PANEL
       ========================================== -->
  <div class="map-layout">
    
    <!-- COLUMNA 1: El Mapa Interactivo (Leaflet) -->
    <div class="map-container-wrapper">
      <div class="search-box-container" style="margin-bottom: 16px; position: relative;">
        <label for="map-search-input" class="overline" style="margin-bottom: 6px;">Buscar espacio o aula</label>
        <div style="display: flex; gap: 8px;">
          <input 
            type="search" 
            id="map-search-input" 
            class="input" 
            placeholder="Ej. Mecatrónica, Dirección, Aula 1..."
            autocomplete="off"
            aria-controls="search-suggestions"
            style="flex: 1;"
          />
          <button id="btn-clear-search" class="btn btn--ghost" style="height: 44px; display: none;">Limpiar</button>
        </div>
        <div id="search-suggestions" class="search-suggestions" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--color-surface); border: 1px solid var(--color-rule-strong); z-index: 100; max-height: 200px; overflow-y: auto;"></div>
      </div>
      <div class="map-toolbar">
        <label for="map-base-layer">Vista
          <select id="map-base-layer" class="input">
            <option value="streets">Calles · OpenStreetMap</option>
            <option value="campus">Plano del campus</option>
          </select>
        </label>
        <button type="button" id="btn-reset-map" class="btn btn--ghost">Ver todo el campus</button>
      </div>
      <p id="map-status" class="map-status" role="status" aria-live="polite">Cargando espacios del campus…</p>
      <div id="map" class="interactive-map" role="region" aria-label="Mapa interactivo del campus Coquimatlán"></div>
      <div class="map-legend" aria-label="Colores de las facultades">
        <span><i style="background: #4caf50"></i>FIME</span>
        <span><i style="background: #2196f3"></i>FIC</span>
        <span><i style="background: #ff9800"></i>FCQ</span>
        <span><i style="background: #e91e63"></i>FAYD</span>
        <span><i style="background: #64748b"></i>Otros espacios</span>
      </div>
      <p class="map-note">
        Selecciona un edificio para consultar sus aulas. El plano del campus no necesita cargar imágenes externas.
        Cartografía © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors (ODbL)</a>.
        <a href="https://www.openstreetmap.org/fixthemap" target="_blank" rel="noopener noreferrer">Reportar un error cartográfico</a>.
      </p>
      <noscript><p>Activa JavaScript para consultar el mapa y buscar aulas. También puedes <a href="https://www.openstreetmap.org/#map=18/19.2135/-103.804">ver el campus en OpenStreetMap</a>.</p></noscript>
    </div>

    <!-- COLUMNA 2: Panel de Información Dinámica -->
    <div class="info-panel-wrapper">
      <div class="info-panel" id="space-details-panel">
        <span class="overline" style="margin-bottom: 16px; display: block;">Detalle de Espacio</span>
        
        <!-- Estado Inicial (Vacío) -->
        <div id="panel-empty-state" class="empty-state">
          Selecciona un espacio en el mapa interactivo para consultar su programación y características.
        </div>

        <!-- Estado Activo -->
        <div id="panel-content-state" style="display: none;">
          <div>
            <span id="panel-space-type" class="tag" style="margin-bottom: 8px;">Tipo</span>
            <h2 id="panel-space-name" style="font-size: 2rem; font-weight: 800; color: var(--color-ink); line-height: 1.1; letter-spacing: -0.03em;">
              Nombre Espacio
            </h2>
          </div>
          
          <hr class="rule" style="margin: 24px 0;" />

          <!-- Vista de Aulas Internas para Estudiantes -->
          <div id="panel-rooms-read-only" style="margin-bottom: 24px; display: none;">
            <span class="overline" style="margin-bottom: 10px; display: block; color: var(--color-ink-2);">Aulas y Laboratorios</span>
            <div id="panel-rooms-read-only-list" style="display: flex; flex-wrap: wrap; gap: 6px;">
              <!-- Se insertan por JS -->
            </div>
            <hr class="rule" style="margin: 24px 0 0 0;" />
          </div>

          <div>
            <span class="overline" style="margin-bottom: 12px; display: block; color: var(--color-primary);">Clases Programadas</span>
            <div id="panel-classes-list" style="display: flex; flex-direction: column; gap: 16px;">
              <!-- Se insertan por JS -->
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Inyección de Datos -->
  <script is:inline define:vars={{ schedulesJson }}>
    window.__SCHEDULES__ = JSON.parse(schedulesJson);
  </script>

  <!-- ==========================================
       3. INTEGRACIÓN DE LEAFLET.JS (LOCAL BUNDLE)
       ========================================== -->
  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    (function initLeaflet() {
      // Los edificios se sirven desde el proyecto; Leaflet también se empaqueta localmente.
      const map = L.map('map', {
        zoomControl: false,
        minZoom: 15,
        maxZoom: 21,
        maxBoundsViscosity: 0.8
      }).setView([19.2135, -103.804], 18);

      L.control.zoom({ position: 'bottomright' }).addTo(map);
      L.control.scale({ imperial: false, position: 'bottomleft' }).addTo(map);

      // Carga interactiva únicamente, con caché HTTP del navegador y Referer válido.
      // Política: https://operations.osmfoundation.org/policies/tiles/
      // maxNativeZoom evita pedir teselas inexistentes al acercarse a un aula.
      const streetLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
        maxNativeZoom: 19,
        maxZoom: 21,
        referrerPolicy: 'strict-origin-when-cross-origin',
        updateWhenIdle: true,
        keepBuffer: 1
      });
      const baseLayerSelect = document.getElementById('map-base-layer');
      const mapStatus = document.getElementById('map-status');
      let campusBounds;
      let campusLoaded = false;
      let streetFailures = 0;

      function updateMapStatus(message) {
        if (mapStatus) mapStatus.textContent = message;
      }

      function setBaseLayer(value, failed = false) {
        if (baseLayerSelect) baseLayerSelect.value = value;
        if (value === 'streets') {
          streetFailures = 0;
          streetLayer.addTo(map);
          updateMapStatus(campusLoaded ? 'Busca un aula o selecciona un edificio en el mapa.' : 'Cargando espacios del campus…');
        } else {
          map.removeLayer(streetLayer);
          updateMapStatus(failed
            ? (campusLoaded
              ? 'No se pudo cargar el mapa de calles. Puedes seguir consultando los edificios en el plano del campus.'
              : 'No se pudieron cargar el mapa de calles ni el directorio. Recarga la página para volver a intentarlo.')
            : 'Plano del campus: edificios y aulas sin imágenes externas.');
        }
      }

      baseLayerSelect?.addEventListener('change', () => setBaseLayer(baseLayerSelect.value));
      streetLayer.on('tileerror', () => {
        streetFailures += 1;
        if (streetFailures >= 3 && map.hasLayer(streetLayer)) setBaseLayer('campus', true);
      });
      document.getElementById('btn-reset-map')?.addEventListener('click', () => {
        if (campusBounds?.isValid()) map.fitBounds(campusBounds, { padding: [20, 20], maxZoom: 18 });
      });

      function textContent(value) {
        const element = document.createElement('span');
        element.textContent = String(value ?? '');
        return element;
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, character => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[character]);
      }

      function normalizeSearch(value) {
        return String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      }

      // Elementos del DOM para el panel
      const emptyState = document.getElementById("panel-empty-state");
      const contentState = document.getElementById("panel-content-state");
      const pName = document.getElementById("panel-space-name");
      const pType = document.getElementById("panel-space-type");
      const pClassesList = document.getElementById("panel-classes-list");
      const pRoomsReadOnly = document.getElementById("panel-rooms-read-only");
      const pRoomsReadOnlyList = document.getElementById("panel-rooms-read-only-list");
      let localSpaces = [];

      function isRoomMatch(targetStr, spaceStr) {
        if (!targetStr || !spaceStr) return false;
        
        const clean = (str) => normalizeSearch(str)
          .replace(/^(aula|laboratorio|taller|edificio)\s+/, '')
          .replace(/\(.*\)/, '')
          .replace(/[°ª]/g, '')
          .trim();

        const normTarget = clean(targetStr);
        const normSpace = clean(spaceStr);

        if (normTarget === normSpace) return true;

        if (normTarget.includes('/')) {
          const parts = normTarget.split('/').map(p => clean(p));
          if (parts.some(p => p === normSpace || (p.length >= 2 && normSpace.includes(p)))) return true;
        }
        if (normSpace.includes('/')) {
          const parts = normSpace.split('/').map(p => clean(p));
          if (parts.some(p => p === normTarget || (p.length >= 2 && normTarget.includes(p)))) return true;
        }

        if (normTarget.length >= 2 && normSpace.includes(normTarget)) return true;
        if (normSpace.length >= 2 && normTarget.includes(normSpace)) return true;

        return false;
      }

      // Función para renderizar detalles del panel lateral
      function displaySpaceDetails(feature) {
        if (emptyState) emptyState.style.display = "none";
        if (contentState) contentState.style.display = "block";

        const props = feature.properties || {};
        const spaceName = props.name || "Edificio sin nombre";
        
        localSpaces = props.spaces ? JSON.parse(JSON.stringify(props.spaces)) : [];
        
        if (pName) pName.textContent = spaceName;

        // Renderizar vista de solo lectura de aulas internas
        if (pRoomsReadOnly && pRoomsReadOnlyList) {
          pRoomsReadOnlyList.innerHTML = "";
          if (localSpaces.length > 0) {
            localSpaces.forEach(room => {
              const tag = document.createElement("span");
              tag.style.cssText = `
                display: inline-block;
                padding: 4px 8px;
                font-size: 0.75rem;
                font-family: var(--font-sans);
                font-weight: 700;
                border-radius: 4px;
                border: 1px solid ${getFacultyColor(room.faculty)};
                background: ${getFacultyColor(room.faculty)}15;
                color: ${getFacultyColor(room.faculty)};
              `;
              tag.textContent = `${room.name} (${room.faculty})`;
              pRoomsReadOnlyList.appendChild(tag);
            });
            pRoomsReadOnly.style.display = "block";
          } else {
            pRoomsReadOnly.style.display = "none";
          }
        }

        if (pType) {
          const types = { university: 'Edificio universitario', theatre: 'Auditorio', yes: 'Edificio', laboratory: 'Laboratorio' };
          const typeStr = props.amenity || props.building || 'general';
          pType.textContent = types[typeStr] || 'Espacio del campus';
          pType.className = 'tag tag--primary';
        }

        // Buscar clases programadas para cualquiera de los sub-espacios de este edificio
        if (pClassesList) {
          pClassesList.innerHTML = "";
          
          const classes = (Array.isArray(window.__SCHEDULES__) ? window.__SCHEDULES__ : []).filter(s => {
            if (!s.classroom_name) return false;
            if (isRoomMatch(s.classroom_name, spaceName)) return true;
            return localSpaces.some(r => r.name && isRoomMatch(s.classroom_name, r.name));
          });

          if (classes && classes.length > 0) {
            classes.forEach(c => {
              const row = document.createElement("div");
              row.style.cssText = "padding-bottom: 12px; border-bottom: 1px solid var(--color-rule);";
              row.innerHTML = 
                '<strong style="display: block; font-size: 1rem; color: var(--color-ink); margin-bottom: 4px;">' + escapeHtml(c.subject_name) + '</strong>' +
                '<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8125rem; color: var(--color-ink-2);">' +
                '<span>Grupo: <strong style="color: var(--color-ink);">' + escapeHtml(c.group_name || c.class_group_name || "") + '</strong></span>' +
                '<span style="font-family: var(--font-mono);">' + escapeHtml(c.day_of_week) + ' ' + escapeHtml(String(c.start_time || '').slice(0,5)) + '-' + escapeHtml(String(c.end_time || '').slice(0,5)) + '</span>' +
                '</div>' +
                '<span style="display: block; font-size: 0.75rem; color: var(--color-ink-3); margin-top: 4px;">Espacio: <strong>' + escapeHtml(c.classroom_name || "N/A") + '</strong> | Docente: ' + escapeHtml(c.professor_name || "Sin asignar") + '</span>';
              pClassesList.appendChild(row);
            });
          } else {
            pClassesList.innerHTML = 
              '<p style="font-size: 0.875rem; color: var(--color-ink-3); font-style: italic;">No hay horarios registrados para este espacio. Esto no confirma que esté disponible.</p>';
          }
        }
      }

      // Colores de Facultades para el Swiss Map
      function getFacultyColor(faculty) {
        switch (faculty) {
          case 'FIME': return '#4caf50'; // Verde
          case 'FIC': return '#2196f3';  // Azul
          case 'FCQ': return '#ff9800';  // Naranja
          case 'FAYD': return '#e91e63'; // Rosa/Magente
          default: return '#64748b'; // Gris oscuro
        }
      }

      // Estilo de los Polígonos GeoJSON (pintado por la facultad de la primera aula registrada)
      function baseStyle(feature) {
        const props = feature.properties || {};
        const spaces = props.spaces || [];
        const faculty = spaces.length > 0 ? spaces[0].faculty : props.faculty;
        const color = getFacultyColor(faculty);
        return {
          color: "var(--color-ink)",
          weight: 1,
          fillColor: color,
          fillOpacity: faculty ? 0.4 : 0.18
        };
      }

      let geojsonLayer;

      // 4. Cargar GeoJSON
      fetch('/campus.geojson', { signal: AbortSignal.timeout(15000) })
        .then(res => {
          if (!res.ok) throw new Error(`GeoJSON HTTP ${res.status}`);
          return res.json();
        })
        .then(data => {
          if (data.type !== 'FeatureCollection' || !Array.isArray(data.features)) throw new Error('Formato de campus inválido');
          geojsonLayer = L.geoJSON(data, {
            attribution: 'Edificios: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a> · Directorio PICA',
            style: baseStyle,
            onEachFeature: (feature, layer) => {
              // Tooltip básico al hover
              if (feature.properties && feature.properties.name) {
                layer.bindTooltip(textContent(feature.properties.name), {
                  className: 'swiss-tooltip',
                  direction: 'top'
                });
              }

              // Eventos de interacción
              layer.on({
                mouseover: (e) => {
                  const l = e.target;
                  l.setStyle({
                    color: "var(--color-primary)",
                    weight: 2,
                    fillOpacity: 0.5
                  });
                  if (!L.Browser.ie && !L.Browser.opera && !L.Browser.edge) {
                    l.bringToFront();
                  }
                },
                mouseout: (e) => {
                  geojsonLayer.resetStyle(e.target);
                },
                click: (e) => {
                  map.fitBounds(e.target.getBounds(), { padding: [50, 50], maxZoom: 20 });
                  displaySpaceDetails(feature);
                }
              });
            }
          }).addTo(map);

          // Ajustar mapa a los datos iniciales
          campusBounds = geojsonLayer.getBounds();
          if (campusBounds.isValid()) {
            map.fitBounds(campusBounds, { padding: [20, 20], maxZoom: 18 });
            // Permitir ver calles de acceso y volver al campus con el botón.
            map.setMaxBounds(campusBounds.pad(1));
          }
          campusLoaded = true;
          setBaseLayer(baseLayerSelect?.value || 'streets');

           // La URL puede seleccionar un espacio; la vista pública es de solo lectura.
           const urlParams = new URLSearchParams(window.location.search);
           const highlightName = urlParams.get('highlight');
           if (highlightName) {
             let foundLayer = null;
             geojsonLayer.eachLayer(layer => {
               if (foundLayer) return;
               const props = layer.feature.properties || {};
               const bName = props.name || "";
               const spaces = props.spaces || [];
               
               if (isRoomMatch(highlightName, bName)) {
                 foundLayer = layer;
                 return;
               }
               if (spaces.some(sp => isRoomMatch(highlightName, sp.name))) {
                 foundLayer = layer;
                 return;
               }
             });

             if (foundLayer) {
               map.fitBounds(foundLayer.getBounds(), { maxZoom: 20, padding: [50, 50] });
               foundLayer.fire('click');
             }
           }

          // ── Search & Filter Logic ──
          const searchInput = document.getElementById("map-search-input");
          const clearBtn = document.getElementById("btn-clear-search");
          const suggestionsContainer = document.getElementById("search-suggestions");

          function performSearch(query) {
            const normalizedQuery = normalizeSearch(query);
            if (!normalizedQuery) {
              suggestionsContainer.style.display = "none";
              clearBtn.style.display = "none";
              return;
            }
            
            clearBtn.style.display = "block";
            const matches = [];

            geojsonLayer.eachLayer(layer => {
              const buildingName = layer.feature.properties?.name || "Edificio";
              const spaces = layer.feature.properties?.spaces || [];
              if (layer.feature.properties?.name && normalizeSearch(buildingName).includes(normalizedQuery)) {
                matches.push({ displayName: buildingName, searchName: buildingName, layer });
              }
              spaces.forEach(space => {
                if (space.name && normalizeSearch(space.name).includes(normalizedQuery) && normalizeSearch(space.name) !== normalizeSearch(buildingName)) {
                  matches.push({ 
                    displayName: `${space.name} (${buildingName})`, 
                    searchName: space.name,
                    layer 
                  });
                }
              });
            });

            if (matches.length > 0) {
              suggestionsContainer.innerHTML = matches.slice(0, 30).map((m, idx) =>
                `<button type="button" class="suggestion-item" style="display: block; width: 100%; text-align: left; padding: 10px 16px; background: none; border: none; border-bottom: 1px solid var(--color-rule); cursor: pointer; font-size: 0.875rem; font-family: var(--font-sans); color: var(--color-ink);" data-idx="${idx}">${escapeHtml(m.displayName)}</button>`
              ).join('');
              suggestionsContainer.style.display = "block";

              // Add click listener to suggestions
              suggestionsContainer.querySelectorAll(".suggestion-item").forEach(item => {
                item.addEventListener("click", () => {
                  const idx = parseInt(item.getAttribute("data-idx"), 10);
                  const match = matches[idx];
                  if (match) {
                    match.layer.fire("click");
                    searchInput.value = match.searchName;
                    suggestionsContainer.style.display = "none";
                  }
                });
              });
            } else {
              suggestionsContainer.innerHTML = `<div style="padding: 10px 16px; font-size: 0.875rem; color: var(--color-ink-3); font-style: italic;">No se encontraron espacios</div>`;
              suggestionsContainer.style.display = "block";
            }
          }

          searchInput?.addEventListener("input", (e) => {
            performSearch(e.target.value);
          });

          searchInput?.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') suggestionsContainer.style.display = 'none';
            if (event.key === 'ArrowDown' && suggestionsContainer.style.display !== 'none') {
              event.preventDefault();
              suggestionsContainer.querySelector('button')?.focus();
            }
            if (event.key === 'Enter' && suggestionsContainer.style.display !== 'none') {
              event.preventDefault();
              suggestionsContainer.querySelector('button')?.click();
            }
          });

          clearBtn?.addEventListener("click", () => {
            if (searchInput) searchInput.value = "";
            suggestionsContainer.style.display = "none";
            clearBtn.style.display = "none";
          });

          // Close suggestions when clicking outside
          document.addEventListener("click", (e) => {
            if (!suggestionsContainer.contains(e.target) && e.target !== searchInput) {
              suggestionsContainer.style.display = "none";
            }
          });
        })
        .catch(err => {
          console.error('Error cargando GeoJSON:', err);
          if (baseLayerSelect?.value === 'streets') streetLayer.addTo(map);
          updateMapStatus('No se pudo cargar el directorio de edificios. Recarga la página para volver a intentarlo.');
          if (emptyState) emptyState.textContent = 'El directorio de aulas no está disponible por el momento.';
        });
    })();
  </script>

</InstitutionalLayout>

<style>
  /* Page Header */
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 24px;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }
  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
    margin-top: 12px;
  }

  /* Layout Mapa y Panel */
  .map-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .map-layout {
      grid-template-columns: 2fr 1fr;
      gap: 48px;
    }
  }

  /* Contenedor del Mapa */
  .map-toolbar {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 12px;
  }
  .map-toolbar label {
    display: grid;
    gap: 6px;
    font-size: 0.8125rem;
  }
  .map-toolbar select { min-width: 230px; }
  .map-status, .map-note {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 12px 0;
  }
  .map-note a { text-decoration: underline; }
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-top: 12px;
    font-size: 0.75rem;
  }
  .map-legend span { display: inline-flex; align-items: center; gap: 5px; }
  .map-legend i { width: 10px; height: 10px; border-radius: 2px; }

  .interactive-map {
    width: 100%;
    height: 60vh;
    min-height: 400px;
    background-color: var(--color-muted); /* Gris claro de fondo mientras carga */
    border: 1px solid var(--color-rule-strong);
    z-index: 10; /* Evitar solapamientos con menús */
  }
  :global(.leaflet-control-attribution) { max-width: 100%; font-size: 10px; }

  /* Panel de Información */
  .info-panel {
    border-top: 2px solid var(--color-ink);
    padding-top: 20px;
  }

  .empty-state {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink-3);
    line-height: 1.5;
    font-style: italic;
    padding: 32px 0;
  }

  /* Tooltip personalizado de Leaflet para igualar estilo suizo */
  :global(.leaflet-tooltip.swiss-tooltip) {
    background-color: var(--color-ink) !important;
    color: var(--color-surface) !important;
    border: none !important;
    border-radius: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 0.6875rem !important;
    font-weight: 700 !important;
