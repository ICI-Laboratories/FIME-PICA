---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import { cargarCarreras, cargarGrupoConProfesores, cargarHorarioDeGrupo, cargarExamenesDeGrupo } from "../../lib/cargarDatos.js";

// Contexto Estudiante
const student = Astro.locals.student;

// Obtener el grupo activo
const activeGroupSlug =
  student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";
const careers = await cargarCarreras();

let activeGroup = null;
let uniqueSubjects = [];
let uniqueProfessors = [];
let examDates = [];

if (activeGroupSlug) {
  try {
    activeGroup = await cargarGrupoConProfesores(activeGroupSlug);
    if (activeGroup) {
      const schedules = await cargarHorarioDeGrupo(activeGroup.id);

      // Agrupar Materias
      const subjectsMap = new Map();
      schedules.forEach((s) => {
        if (!subjectsMap.has(s.subject_name)) {
          subjectsMap.set(s.subject_name, {
            name: s.subject_name,
            professorName: s.professor_name || "Sin asignar",
          });
        }
      });
      uniqueSubjects = Array.from(subjectsMap.values());

      // Agrupar Profesores
      const profsMap = new Map();
      schedules.forEach((s) => {
        if (s.professor_id && !profsMap.has(s.professor_id)) {
          profsMap.set(s.professor_id, {
            name: s.professor_name,
            slug: s.professor_slug,
            email: s.professor_email,
            phone: s.professor_phone,
            office: s.professor_office,
            image: s.professor_image,
          });
        }
      });
      uniqueProfessors = Array.from(profsMap.values());

      examDates = await cargarExamenesDeGrupo(activeGroup.id);
    }
  } catch (e) {
    console.error("Error al consultar perfil del estudiante:", e);
  }
}
---

<InstitutionalLayout title="Mi Perfil — Expediente Estudiantil">
  <!-- ==========================================
       1. ENCABEZADO ASIMÉTRICO (Diseño Suizo)
       ========================================== -->
  <div class="page-header">
    <div class="page-header__content">
      <span class="overline overline--primary">Expediente Centralizado</span>
      <h1 class="page-title">{student.name}</h1>
      <p class="page-subtitle">
        Matrícula: {student.id} &mdash; {student.email}
      </p>
    </div>
    <div class="page-header__actions">
      <!-- Botón minimalista de cierre de sesión -->
      <button class="btn-logout" aria-label="Cerrar sesión">
        Salir del sistema
      </button>
    </div>
  </div>

  <hr class="rule rule--thick" style="margin-bottom: 48px;" />

  <!-- ==========================================
       2. IDENTIDAD ACADÉMICA (Metadatos)
       ========================================== -->
  <section class="profile-section">
    <div class="profile-section__sidebar">
      <span class="overline">Contexto</span>
      <h2 class="section-title">Identidad<br />Académica</h2>
    </div>
    <div class="profile-section__content">
      <div class="metadata-grid">
        <div class="metadata-item">
          <span class="field-label">Carrera Universitaria</span>
          <span class="field-value">{activeGroup?.careerName || "—"}</span>
        </div>
        <div class="metadata-item">
          <span class="field-label">Semestre y Grupo</span>
          <span class="field-value">{activeGroup?.name || "—"}</span>
        </div>
        <div class="metadata-item">
          <span class="field-label">Periodo </span>
          <span class="field-value" style="font-family: var(--font-mono);"
            >2026-I</span
          >
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ==========================================
       3. MATERIAS MATRICULADAS
       ========================================== -->
  <section class="profile-section">
    <div class="profile-section__sidebar">
      <span class="overline">Carga</span>
      <h2 class="section-title">Materias<br />Matriculadas</h2>
      <a
        href="/materias"
        class="link"
        style="font-size: 0.75rem; margin-top: 12px; display: inline-block;"
      >
        Ver detalles en panel →
      </a>
    </div>
    <div class="profile-section__content">
      {
        uniqueSubjects.length > 0 ? (
          <ul class="clean-list">
            {uniqueSubjects.map((sub) => (
              <li class="clean-list__item">
                <div>
                  <strong style="display: block; font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin-bottom: 4px;">
                    {sub.name}
                  </strong>
                  <span style="font-size: 0.8125rem; color: var(--color-ink-2);">
                    Titular: {sub.professorName}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-text">No se ha registrado carga académica.</p>
        )
      }
    </div>
  </section>

  <hr class="rule" />

  <!-- ==========================================
       4. PLANTILLA DOCENTE
       ========================================== -->
  <section class="profile-section">
    <div class="profile-section__sidebar">
      <span class="overline">Docentes</span>
      <h2 class="section-title">Plantilla<br />Asignada</h2>
    </div>
    <div class="profile-section__content">
      {
        uniqueProfessors.length > 0 ? (
          <div class="professors-grid">
            {uniqueProfessors.map((prof) => (
              <div class="prof-card">
                <div class="prof-card__img-container">
                  {prof.image ? (
                    <img
                      src={prof.image}
                      alt={prof.name}
                      class="prof-card__img"
                    />
                  ) : (
                    <div class="prof-card__img-placeholder">[•_•]</div>
                  )}
                </div>
                <div class="prof-card__info">
                  <a
                    href={prof.slug ? `/profesores/${prof.slug}` : "#"}
                    class="prof-card__name"
                  >
                    {prof.name}
                  </a>
                  <span class="prof-card__meta">
                    {prof.email || "Sin email registrado"}
                  </span>
                  <span class="prof-card__meta">
                    Cubículo: {prof.office || "—"}
                  </span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-text">No hay docentes registrados.</p>
        )
      }
    </div>
  </section>

  <hr class="rule" />

  <!-- ==========================================
       5. LÍNEA DE TIEMPO (EVALUACIONES)
       ========================================== -->
  <section class="profile-section">
    <div class="profile-section__sidebar">
      <span class="overline">Calendario</span>
      <h2 class="section-title">Próximas<br />Evaluaciones</h2>
    </div>
    <div class="profile-section__content">
      {
        examDates.length > 0 ? (
          <div class="timeline">
            {examDates.map((ex, index) => {
              const d = new Date(ex.exam_date);
              const dateStr = d.toLocaleDateString("es-MX", {
                day: "numeric",
                month: "long",
              });
              const isPast = d < new Date();

              return (
                <div
                  class={`timeline__item ${isPast ? "timeline__item--past" : ""}`}
                >
                  <div class="timeline__date">
                    <span style="font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700;">
                      {dateStr}
                    </span>
                    <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 2px;">
                      {ex.exam_time ? ex.exam_time.substring(0, 5) : ""}
                    </span>
                  </div>
                  <div class="timeline__marker" />
                  <div class="timeline__body">
                    <span
                      class="overline"
                      style="margin-bottom: 4px; display: block;"
                    >
                      {ex.subject_name}
                    </span>
                    <strong style="font-size: 1rem; color: var(--color-ink); display: block;">
                      {ex.exam_name}
                    </strong>
                    {ex.classroom && (
                      <span style="font-size: 0.75rem; color: var(--color-ink-2); display: block; margin-top: 4px;">
                        Aula: {ex.classroom}
                      </span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <p class="empty-text">
            No hay evaluaciones programadas por el momento.
          </p>
        )
      }
    </div>
  </section>

  <script>
    // Configuración básica del botón de cierre de sesión
    document.querySelector(".btn-logout")?.addEventListener("click", () => {
      // Simulación de cierre de sesión
      localStorage.removeItem("pica_selected_group");
      window.location.href = "/";
    });
  </script>
</InstitutionalLayout>

<style>
  /* Page Header */
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 24px;
  }
  @media (min-width: 768px) {
    .page-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .page-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    margin-top: 8px;
  }
  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
    margin-top: 12px;
  }

  .btn-logout {
    background: transparent;
    border: 1px solid var(--color-rule-strong);
    padding: 10px 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    cursor: pointer;
    transition: all 120ms;
  }
  .btn-logout:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  /* Secciones Estilo Suizo (2/3 - 1/3) */
  .profile-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 40px 0;
  }
  @media (min-width: 768px) {
    .profile-section {
      grid-template-columns: 240px 1fr;
      gap: 48px;
    }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 8px;
  }

  /* Grid de metadatos */
  .metadata-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .metadata-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .field-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  /* Lista limpia (Materias) */
  .clean-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clean-list__item {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .clean-list__item:first-child {
    padding-top: 0;
  }
  .clean-list__item:last-child {
    border-bottom: none;
  }

  /* Grid de Profesores */
  .professors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .professors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .prof-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .prof-card__img-container {
    width: 64px;
    height: 64px;
    border: 1px solid var(--color-rule-strong);
    flex-shrink: 0;
  }
  .prof-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prof-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-3);
  }
  .prof-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .prof-card__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .prof-card__name:hover {
    text-decoration: underline;
    color: var(--color-primary);
  }
  .prof-card__meta {
    font-size: 0.75rem;
    color: var(--color-ink-2);
  }

  /* Línea de tiempo (Timeline) */
  .timeline {
    display: flex;
    flex-direction: column;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 80px 24px 1fr;
    gap: 16px;
    padding-bottom: 32px;
  }
  .timeline__date {
    display: flex;
    flex-direction: column;
    text-align: right;
    padding-top: 2px;
  }
  .timeline__marker {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--color-ink);
    position: relative;
    margin-top: 6px;
    margin-left: 6px;
  }
  .timeline__marker::after {
    content: "";
    position: absolute;
    top: 11px;
    left: 5px;
    width: 1px;
    height: 200px; /* Suficiente para conectar con el siguiente */
    background-color: var(--color-rule-strong);
  }
  .timeline__item:last-child .timeline__marker::after {
    display: none;
  }

  .timeline__item--past .timeline__marker {
    background-color: var(--color-rule-strong);
  }
  .timeline__item--past .timeline__body strong {
    color: var(--color-ink-2);
  }
  .timeline__item--past .timeline__date span {
    color: var(--color-ink-3);
  }

  .empty-text {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    font-style: italic;
  }
</style>
